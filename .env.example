# MediMind AI - Environment Variables Template

# Project Config
PROJECT_NAME="MediMind AI"
API_V1_STR="/api/v1"

# Database
# For docker-compose: postgresql://postgres:postgrespassword@db:5432/medimind
# For local run: postgresql://postgres:postgrespassword@localhost:5432/medimind
DATABASE_URL="postgresql://postgres:postgrespassword@db:5432/medimind"

# CORS Origins
# Must be a JSON-formatted list of strings
BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://localhost:5173", "https://medimind.ai"]'

# JWT Configuration
JWT_SECRET_KEY="production_ready_super_secret_key_change_me_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Gemini API Key
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Redis Configuration
REDIS_URL="redis://redis:6379/0"

# ChromaDB Configuration
CHROMA_HOST="chromadb"
CHROMA_PORT=8000

